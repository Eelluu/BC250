# Clawd — /opt/netscan/.env
# ============================================================================
# Every secret and tunable lives here. `sudo ./install.sh configure` writes the
# skeleton; everything below can also be edited by hand.
#
#   Location : /opt/netscan/.env      (chmod 600 — it holds the bot token)
#   Applied  : when the process starts, so run
#              `sudo systemctl restart queue-runner`  (Alpine: `rc-service`) after editing.
#   In git   : NO. The file is gitignored and never leaves the server. This
#              template is the reference, not the live file.
#
# The cron jobs run as child processes of queue-runner and inherit this
# environment, so job secrets (SIGNAL_*, HASS_*, GITHUB_TOKEN, TRACKER_*) belong
# in this same file.
# ============================================================================

# ── Discord bot ──────────────────────────────────────────────────────────────
DISCORD_TOKEN=""                 # from the Discord Developer Portal
DISCORD_OWNER_ID=""              # the ONLY user the bot answers to
DISCORD_GUILD_ID=""              # optional: sync slash commands to one guild instantly
                                 # (blank/0 = global sync, can take up to 1h to show up)

# ── Chat behaviour ───────────────────────────────────────────────────────────
CHAT_STREAMING="1"               # 1 = write the answer into the message as it streams, 0 = one send
STREAM_EDIT_INTERVAL_S="2.0"     # seconds between message edits (don't go below 2: Discord rate limit)
USEFUL_HOURS_START="9"           # cron jobs are paused between these hours
USEFUL_HOURS_END="21"
SMART_MODE_CURFEW_HOUR="1"       # force sleep mode after this hour when smart mode is on

# ── LLM (llama-swap) ─────────────────────────────────────────────────────────
LLM_MODEL="gemma4-12b-q3"        # MUST match a name in /opt/llama-swap/config.yaml
LLM_URL="http://localhost:8080/v1"
# UNUSED in v10: still asked for by the installer, but nothing reads them
# (the automatic per-message router was removed). Leave empty.
LLM_FALLBACK_MODEL=""
LLM_SMART_MODEL=""

# ── Stable Diffusion / image models ──────────────────────────────────────────
# Leave a value EMPTY to let the bot auto-detect the file inside that directory
# (it walks the tree recursively, so subfolders like vae/ are fine).
SD_MODELS_DIR="/opt/stable-diffusion.cpp/models"
SD_CLI="/opt/stable-diffusion.cpp/build/bin/sd-cli"

# Default image model for /imagen and the LLM's generate-image tool:
#   auto | zimage | qwen | hidream | flux | flux2
# "auto" prefers Z-Image Turbo when its files are present. Any request can force
# another one with a leading `--model=<x>` (the /imagen `modelo` option does this).
SD_IMAGE_MODEL="auto"

# Z-Image Turbo — distilled DiT: 8 steps, cfg 1.0, 4B text encoder (~6 GB total).
# Much faster than Qwen-Image 2.1. Its VAE is the FLUX `ae.safetensors`; leave
# SD_ZIMAGE_VAE empty to fall back to $SD_MODELS_DIR/flux/ae.safetensors.
SD_ZIMAGE_DIR="/opt/stable-diffusion.cpp/models/z_image"
SD_ZIMAGE_MODEL=""               # z_image_turbo-Q4_K.gguf
SD_ZIMAGE_VAE=""                 # empty = flux/ae.safetensors
SD_ZIMAGE_LLM=""                 # Qwen3-4B-Instruct-2507-Q4_K_M.gguf
# Turbo is distilled: few steps at cfg 1.0. At cfg 1.0 there is NO guidance, so a
# negative prompt does nothing. Do not reuse the Qwen knobs (6.0 / 20 steps).
SD_ZIMAGE_CFG_SCALE="1.0"
SD_ZIMAGE_STEPS="8"
SD_ZIMAGE_SIZE="1024"

# Qwen-Image 2.1 — text-to-image + native instruction-based editing
SD_QWEN_DIR="/opt/stable-diffusion.cpp/models/qwen_image"
SD_QWEN_MODEL=""                 # qwen_image_2.1-Q4_K.gguf
                                 #   uncensored drop-in: qwen-image-2.1-UC-Q4_K_M.gguf
SD_QWEN_VAE=""                   # vae/qwen_image_2.1_vae_bf16.safetensors
SD_QWEN_LLM=""                   # Qwen3VL-8B-Instruct-Q4_K_M.gguf
SD_QWEN_VISION=""                # mmproj-Qwen3VL-8B-Instruct-F16.gguf  (editing only)
# Sampling. Defaults are sd.cpp's own examples (--cfg-scale 6.0, 20 steps, 512px).
# A ComfyUI graph may run editing at CFG 1.5 — that does NOT transfer to sd.cpp.
# SD_QWEN_SIZE must be a multiple of 32.
SD_QWEN_CFG_SCALE="6.0"
SD_QWEN_STEPS="20"
SD_QWEN_SIZE="512"
# Extra sd.cpp flags. Recommended here:
#   SD_QWEN_MODEL_ARGS="qwen_image_2_1_prefix_cache_type=q8_0"   (~1 GiB less cache)
SD_QWEN_MODEL_ARGS=""

# Edición (Qwen-Image 2.1 es el único que edita aquí). Knobs aparte de los de
# generación porque quieren ajustes distintos.
# La salida conserva el ASPECTO de la referencia (lado largo = SD_QWEN_EDIT_SIZE,
# redondeado a múltiplos de 32). SD_QWEN_EDIT_SQUARE="1" recupera el achatado
# cuadrado antiguo. SD_QWEN_EDIT_SIZE="512" es conservador; "1024" sale mejor pero
# puede tropezar con el bug de memoria de sd.cpp en UMA (ver SD_QWEN_OFFLOAD).
SD_QWEN_EDIT_CFG_SCALE="6.0"
SD_QWEN_EDIT_STEPS="20"
SD_QWEN_EDIT_SIZE="512"
SD_QWEN_EDIT_SQUARE="0"
# "cpu" (por defecto) pasa --offload-to-cpu: los pesos viven en RAM. En esta caja
# UMA el reporte de memoria libre del driver se desborda a 1024px y sd.cpp falla el
# workspace; con "gpu" se quita el flag y sd.cpp gestiona el pool entero. Pruébalo
# si ves "reported free 17592... MB" o "failed during workspace capacity check".
SD_QWEN_OFFLOAD="cpu"
# Editar es el camino lento (modelo + encoder 8B + proyector de visión + doble
# condicionado); en esta caja tarda minutos, así que tiene su propio presupuesto
# en vez de los 300 s de la generación.
SD_EDIT_TIMEOUT_S="900"
# Negative prompt for image jobs ("" = none, the sd.cpp default)
SD_NEGATIVE_PROMPT=""

# HiDream-O1 (unified pixel transformer — no VAE/CLIP/T5)
SD_HIDREAM_DIR="/opt/stable-diffusion.cpp/models/hidream"
SD_HIDREAM_MODEL=""

# FLUX.2 (text-to-image)
SD_FLUX2_MODEL=""
SD_FLUX2_VAE=""
SD_FLUX2_LLM=""
# FLUX.1 (fallback) and Kontext (editing)
SD_FLUX_MODEL=""
SD_FLUX_VAE=""
SD_FLUX_CLIP_L=""
SD_FLUX_T5XXL=""
SD_KONTEXT_MODEL=""
# WAN (video, two-pass: high-noise + low-noise)
SD_WAN_MODEL=""
SD_WAN_HIGH_NOISE=""
SD_WAN_VAE=""
SD_WAN_T5XXL=""
# ESRGAN (4x upscale)
SD_ESRGAN_MODEL="/opt/stable-diffusion.cpp/models/esrgan/RealESRGAN_x4plus.pth"

# Derived from SD_MODELS_DIR unless set explicitly:
#   SD_FLUX_DIR="$SD_MODELS_DIR/flux"   SD_FLUX2_DIR="$SD_MODELS_DIR/flux2"
#   SD_WAN_DIR="$SD_MODELS_DIR/wan"     SD_HIDREAM_DIR="$SD_MODELS_DIR/hidream"
#   SD_QWEN_DIR="$SD_MODELS_DIR/qwen_image"   SD_ZIMAGE_DIR="$SD_MODELS_DIR/z_image"

# ── Hugging Face CLI ─────────────────────────────────────────────────────────
HF_XET_HIGH_PERFORMANCE="1"      # parallel chunked downloads
HF_HUB_DOWNLOAD_TIMEOUT="60"

# ── Cron job secrets (read by /opt/netscan/*.py — uncomment what you use) ────
# HASS_URL="http://homeassistant.local:8123"
# HASS_TOKEN=""
# GITHUB_TOKEN=""
# TRACKER_SERVER=""
# TRACKER_IMEI=""
# TRACKER_PASSWORD=""
# KNOWN_LOCATIONS_JSON="/opt/netscan/data/car-known-locations.json"
# NETSCAN_DATA="/opt/netscan/data"
# NETSCAN_WEB="/opt/netscan/web"
# Búsqueda para el agente de investigación y el job de música: por defecto usa el
# SearXNG local (install.sh lo instala). Con JAMENDO_CLIENT_ID (gratis en
# devportal.jamendo.com) el job de música busca además en el catálogo Creative
# Commons de Jamendo, donde la licencia viene verificada por pista en vez de
# inferida de un fragmento de búsqueda.
# SEARXNG_URL="http://127.0.0.1:8890"
# JAMENDO_CLIENT_ID=""
# WEBUI_BIND="0.0.0.0"

# ── EXEC acotado (opcional; el bot funciona igual sin esto) ──────────────────
# is_command_safe() sigue siendo el portero (binarios permitidos, sin
# metacaracteres, cat/ls confinados a /opt/netscan y /tmp, intérpretes sólo desde
# SCRIPT_ROOT, curl sin escritura). Estas variables añaden lo que le falta:
#   * límites de recursos por comando -> un script desbocado ya no se lleva por
#     delante a llama.cpp (necesita 'prlimit', paquete util-linux)
#   * allowlist declarativa en netscan/exec-policy.json (amplía sin tocar código)
#   * sandbox podman opcional para intérpretes (apagado por defecto)
EXEC_LIMITS_MB="2048"            # RLIMIT_AS por comando EXEC
EXEC_CPU_S="30"                  # RLIMIT_CPU (coincide con SIGNAL_EXEC_TIMEOUT_S)
EXEC_NPROC="128"                 # procesos/hilos máximos
EXEC_FSIZE_MB="64"               # tamaño máximo de fichero escrito
# EXEC_POLICY_FILE="/opt/netscan/exec-policy.json"
# EXEC_AUDIT_LOG="/opt/netscan/data/exec-audit.jsonl"   # una línea JSON por EXEC
# Sandbox (opt-in): los comandos de `sandbox_bins` van a podman con FS de sólo
# lectura, sin red y sin privilegios. Necesita una imagen CON las dependencias de
# tus scripts; mientras no la tengas, déjalo en 0 (el host ya lleva los límites).
# EXEC_SANDBOX="0"
# EXEC_SANDBOX_IMAGE="python:3.12-alpine"
# EXEC_SANDBOX_CPUS="2"
# EXEC_SANDBOX_NET="0"           # 1 = dar red al sandbox
